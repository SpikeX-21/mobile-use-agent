# SECRET-BEARING INTERNAL POC IMAGE. NEVER PUBLISH OR USE IN PRODUCTION.
FROM python:3.11.13-slim-bookworm AS builder

WORKDIR /opt/mobile-agent

RUN apt-get update \
    && apt-get install --yes --no-install-recommends gcc libc6-dev \
    && python -m pip install --no-cache-dir uv==0.8.11 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project

COPY mobile_agent ./mobile_agent
RUN find mobile_agent -type f ! -name '*.py' -delete \
    && test -z "$(find mobile_agent -type f ! -name '*.py' -print -quit)" \
    && uv sync --frozen --no-dev --no-editable \
    && rm -rf /root/.cache /tmp/*

FROM python:3.11.13-slim-bookworm

LABEL org.opencontainers.image.title="mobile-use KooPhone AgentArts Runtime" \
      org.opencontainers.image.description="secret-bearing internal POC; never publish or use in production" \
      com.mobile-use.security.secret-bearing="true" \
      com.mobile-use.runtime.kind="agentarts" \
      com.mobile-use.target.platform="linux/arm64" \
      com.mobile-use.release.channel="internal-poc"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/mobile-agent/.venv/bin:${PATH}" \
    HOME=/tmp/mobile-agent-home \
    TMPDIR=/tmp \
    XDG_CACHE_HOME=/tmp/mobile-agent-cache \
    AGENT_RUN_PORT=8080 \
    MOBILE_CONFIG_PATH=/opt/mobile-agent/config.toml \
    KOOPHONE_JKS_PATH=/opt/mobile-agent/secrets/koophone.jks \
    EXPERIMENT_RECORD_PATH=/tmp/mobile-agent/experiment-runs.jsonl

WORKDIR /opt/mobile-agent

RUN groupadd --gid 10001 mobile-agent \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /nonexistent mobile-agent \
    && install -d -o 10001 -g 10001 -m 0750 /opt/mobile-agent/secrets

COPY --from=builder --chown=10001:10001 /opt/mobile-agent/.venv /opt/mobile-agent/.venv
COPY --chown=10001:10001 --chmod=0444 config.toml /opt/mobile-agent/config.toml

COPY --chown=10001:10001 --chmod=0400 jwt.jks /opt/mobile-agent/secrets/koophone.jks
RUN test -s /opt/mobile-agent/secrets/koophone.jks

EXPOSE 8080

USER 10001:10001

STOPSIGNAL SIGTERM

ENTRYPOINT ["python", "-m", "mobile_agent.agentarts_runtime"]
